{
  "openapi": "3.1.0",
  "info": {
    "title": "Dike API",
    "description": "Contract for the Dike production API.",
    "version": "v1"
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/auth/google": {
      "get": {
        "operationId": "startGoogleLogin",
        "responses": { "302": { "description": "Redirect to Google" } }
      }
    },
    "/auth/callback/google": {
      "get": {
        "operationId": "googleCallback",
        "responses": {
          "302": { "description": "Redirect to the web application" }
        }
      }
    },
    "/auth/session": {
      "get": {
        "operationId": "getAuthSession",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Current authenticated session",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSessionResponse" }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/session/refresh": {
      "post": {
        "operationId": "refreshAuthSession",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "responses": {
          "200": {
            "description": "Rotated session",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSessionResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/sessions": {
      "get": {
        "operationId": "listAuthSessions",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Sessions for the current user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionListResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/sessions/{sessionHandle}": {
      "delete": {
        "operationId": "revokeAuthSession",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "parameters": [
          {
            "name": "sessionHandle",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Session revoked" },
          "404": {
            "description": "Session not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logoutCurrentSession",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "responses": { "204": { "description": "Logged out" } }
      }
    },
    "/auth/logout-all": {
      "post": {
        "operationId": "logoutAllSessions",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "responses": { "204": { "description": "All sessions revoked" } }
      }
    },
    "/auth/phone": {
      "put": {
        "operationId": "submitPhoneCandidate",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PhoneRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated onboarding state",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSessionResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid phone",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "$ref": "#/components/schemas/ErrorBody" }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": ["code", "message", "requestId", "fields"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "requestId": { "type": "string" },
          "fields": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FieldViolation" }
          }
        }
      },
      "FieldViolation": {
        "type": "object",
        "required": ["field", "code"],
        "properties": {
          "field": { "type": "string" },
          "code": { "type": "string" }
        }
      },
      "AuthSessionResponse": {
        "type": "object",
        "required": ["authenticated", "user", "session"],
        "properties": {
          "authenticated": { "type": "boolean" },
          "user": { "$ref": "#/components/schemas/AuthUser" },
          "session": { "$ref": "#/components/schemas/AuthSession" }
        }
      },
      "AuthUser": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "email",
          "onboardingStatus",
          "phoneStatus",
          "nextAction"
        ],
        "properties": {
          "id": { "type": "string" },
          "displayName": { "type": "string" },
          "avatarUrl": { "type": "string" },
          "email": { "type": "string" },
          "onboardingStatus": { "type": "string" },
          "phoneStatus": { "type": "string" },
          "phoneMasked": { "type": "string" },
          "nextAction": { "type": "string" }
        }
      },
      "AuthSession": {
        "type": "object",
        "required": [
          "id",
          "deviceLabel",
          "createdAt",
          "lastSeenAt",
          "idleExpiresAt",
          "absoluteExpiresAt",
          "current"
        ],
        "properties": {
          "id": { "type": "string" },
          "deviceLabel": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "lastSeenAt": { "type": "string", "format": "date-time" },
          "idleExpiresAt": { "type": "string", "format": "date-time" },
          "absoluteExpiresAt": { "type": "string", "format": "date-time" },
          "current": { "type": "boolean" }
        }
      },
      "SessionListResponse": {
        "type": "object",
        "required": ["sessions"],
        "properties": {
          "sessions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AuthSession" }
          }
        }
      },
      "PhoneRequest": {
        "type": "object",
        "required": ["phoneNumber"],
        "properties": { "phoneNumber": { "type": "string" } }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "DIKE_SESSION"
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-XSRF-TOKEN"
      }
    }
  }
}
