{
  "name": "dike-v2",
  "version": "0.0.0",
  "private": true,
  "description": "Dike greenfield monorepo baseline",
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "prepare": "node scripts/configure-git-hooks.mjs",
    "setup:repo": "node scripts/configure-git-hooks.mjs",
    "format": "prettier --write \"**/*.{css,js,mjs,ts,tsx,md,json,jsonc,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{css,js,mjs,ts,tsx,md,json,jsonc,yaml,yml}\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "check:tracked-files": "node scripts/check-tracked-files.mjs",
    "check:actions": "node scripts/check-actions-pinned.mjs",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @dike/web e2e",
    "build": "pnpm -r --if-present build",
    "dev:web": "pnpm --filter @dike/web dev",
    "dev:mobile": "pnpm --filter @dike/mobile start",
    "dev:api": "node scripts/run-backend.mjs api",
    "dev:worker": "node scripts/run-backend.mjs worker",
    "dev:local": "node scripts/dev-local.mjs",
    "dev": "pnpm dev:local",
    "infra:up": "docker compose -p dike -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -p dike -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -p dike -f infra/docker-compose.yml logs -f",
    "infra:reset": "docker compose -p dike -f infra/docker-compose.yml down --volumes --remove-orphans",
    "api:generate": "node scripts/generate-api-client.mjs",
    "api:check": "node scripts/generate-api-client.mjs --check",
    "mobile:doctor": "pnpm --filter @dike/mobile expo:doctor",
    "verify:local": "pnpm check && pnpm api:check && node scripts/verify-maven.mjs",
    "check:repo": "prettier --check \"**/*.{css,js,mjs,ts,tsx,md,json,jsonc,yaml,yml}\" && markdownlint-cli2 \"**/*.md\" \"#node_modules\" && node scripts/check-tracked-files.mjs && node scripts/check-actions-pinned.mjs",
    "check": "pnpm check:repo && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm api:check"
  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "lint-staged": "16.2.6",
    "markdownlint-cli2": "0.18.1",
    "prettier": "3.6.2",
    "typescript-eslint": "8.71.0"
  },
  "lint-staged": {
    "*.{css,js,mjs,ts,tsx,md,json,jsonc,yaml,yml}": "prettier --write"
  }
}
