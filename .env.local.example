# Local-only development values. Do not reuse outside local development.
DIKE_MONGODB_URI=mongodb://localhost:27017/dike?replicaSet=rs0
DIKE_MONGODB_DATABASE=dike
DIKE_REDIS_HOST=localhost
DIKE_REDIS_PORT=6379
DIKE_STORAGE_ENDPOINT=http://localhost:9000
DIKE_STORAGE_REGION=us-east-1
DIKE_STORAGE_ACCESS_KEY=dike-local
DIKE_STORAGE_SECRET_KEY=dike-local-secret
DIKE_STORAGE_PUBLIC_BUCKET=dike-public
DIKE_STORAGE_PRIVATE_BUCKET=dike-private
DIKE_API_INTERNAL_ORIGIN=http://localhost:8080
DIKE_AUTH_PUBLIC_BASE_URL=http://localhost:3000
DIKE_AUTH_ALLOWED_ORIGINS=http://localhost:3000
DIKE_GOOGLE_CLIENT_ID=replace-with-development-google-client-id
DIKE_GOOGLE_CLIENT_SECRET=replace-with-development-google-client-secret
DIKE_SESSION_COOKIE_NAME=DIKE_SESSION
DIKE_SESSION_COOKIE_SECURE=false
REQUIRE_PHONE_OTP=false
DIKE_SIMULATED_DRIVER_APPROVAL_ENABLED=true
DIKE_OTP_PROVIDER=fake
DIKE_OTP_HMAC_SECRET=local-only-otp-hmac-secret-change-me
DIKE_OTP_RATE_KEY_SECRET=local-only-rate-key-secret-change-me
DIKE_OTP_KEY_VERSION=local-v1
DIKE_OTP_LIFETIME=5m
DIKE_OTP_RESEND_COOLDOWN=60s
DIKE_OTP_MAXIMUM_ATTEMPTS=5
DIKE_OTP_SEND_ENABLED=true
DIKE_OTP_DAILY_CAP=1000
DIKE_ADMIN_BOOTSTRAP_ENABLED=false
DIKE_ADMIN_BOOTSTRAP_DRY_RUN=true
DIKE_ADMIN_BOOTSTRAP_ACCOUNT_ID=
DIKE_ADMIN_BOOTSTRAP_OPERATOR=
DIKE_ADMIN_BOOTSTRAP_REASON=
DIKE_TERMS_VERSION=2026-10-06
DIKE_TERMS_URL=http://localhost:3000/legal/terms
DIKE_PRIVACY_VERSION=2026-10-06
DIKE_PRIVACY_URL=http://localhost:3000/legal/privacy
DIKE_AGE_ATTESTATION_VERSION=2026-10-06
DIKE_FILE_UPLOAD_TTL=5m
DIKE_FILE_DOWNLOAD_TTL=60s
DIKE_FILE_CLEANUP_AGE=24h
DIKE_FILE_CLEANUP_INTERVAL=1h
DIKE_PUBLIC_OBJECT_BASE_URL=http://localhost:9000/dike-public/
DIKE_FILE_INSPECTOR=basic
DIKE_AVATAR_MAXIMUM_BYTES=5242880
DIKE_VERIFICATION_MAXIMUM_BYTES=10485760
DIKE_MAXIMUM_IMAGE_PIXELS=20000000
DIKE_ACCOUNT_DELETION_WAITING_PERIOD=7d
DIKE_ACCOUNT_DELETION_POLICY_VERSION=account-deletion-v1
