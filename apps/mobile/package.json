{
  "name": "@dike/mobile",
  "version": "0.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@dike/api-client-ts": "workspace:*",
    "@dike/design-tokens": "workspace:*",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "1.63.0",
    "@types/react": "~19.2.2",
    "eslint": "^10.12.0",
    "expo-doctor": "^1.20.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/android-fast.ps1",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit",
    "e2e": "playwright test",
    "build": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
    "expo:doctor": "expo-doctor"
  },
  "private": true
}
