# Backend address reachable from the phone. Metro --tunnel does not expose this API.
EXPO_PUBLIC_API_URL=https://api.example.com/api/v1

# Android USB only: after adb reverse tcp:8080 tcp:8080 and tcp:3000 tcp:3000,
# use http://localhost:8080/api/v1 above and opt in below. Development builds only.
EXPO_PUBLIC_ANDROID_USB_LOCALHOST=false
