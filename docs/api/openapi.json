              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UserView"
                }
              }
            }
          },
          "404": {
            "description": "Resource unavailable",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UserView"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited; Retry-After in seconds",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UserView"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UserView"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
