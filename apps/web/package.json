{
  "name": "@dike/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude \"**/e2e/**\"",
    "e2e": "playwright test",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build && node scripts/prepare-cloudflare-assets.mjs",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@dike/api-client-ts": "workspace:*",
    "@dike/design-tokens": "workspace:*",
    "@dike/web-ui": "workspace:*",
    "@hookform/resolvers": "7.0.3",
    "@stomp/stompjs": "7.3.0",
    "@tanstack/react-query": "5.90.5",
    "lucide-react": "0.468.0",
    "maplibre-gl": "^6.14.0",
    "next": "16.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.65.0",
    "three": "^0.186.1",
    "zod": "4.1.12",
    "vinext": "latest",
    "react-server-dom-webpack": "19.3.1",
    "@vinext/cloudflare": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@dike/frontend-config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vite": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "@cloudflare/vite-plugin": "1",
    "wrangler": "latest"
  },
  "type": "module"
}
