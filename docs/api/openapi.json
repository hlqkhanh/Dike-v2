{
  "openapi": "3.1.0",
  "info": {
    "title": "Dike API",
    "description": "Contract for the Dike production API.",
    "version": "v1"
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {},
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "$ref": "#/components/schemas/ErrorBody" }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": ["code", "message", "requestId", "fields"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "requestId": { "type": "string" },
          "fields": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FieldViolation" }
          }
        }
      },
      "FieldViolation": {
        "type": "object",
        "required": ["field", "code"],
        "properties": {
          "field": { "type": "string" },
          "code": { "type": "string" }
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "DIKE_SESSION"
      }
    }
  }
}
