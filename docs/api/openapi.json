{
  "openapi": "3.1.0",
  "info": {
    "title": "Dike API",
    "description": "Contract for the Dike production API.",
    "version": "v1"
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/auth/google": {
      "get": {
        "operationId": "startGoogleLogin",
        "responses": { "302": { "description": "Redirect to Google" } }
      }
    },
    "/auth/callback/google": {
      "get": {
        "operationId": "googleCallback",
        "responses": {
          "302": { "description": "Redirect to the web application" }
        }
      }
    },
    "/auth/session": {
      "get": {
        "operationId": "getAuthSession",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Current authenticated session",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSessionResponse" }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/session/refresh": {
      "post": {
        "operationId": "refreshAuthSession",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "responses": {
          "200": {
            "description": "Rotated session",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSessionResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/sessions": {
      "get": {
        "operationId": "listAuthSessions",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Sessions for the current user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionListResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/sessions/{sessionHandle}": {
      "delete": {
        "operationId": "revokeAuthSession",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "parameters": [
          {
            "name": "sessionHandle",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Session revoked" },
          "404": {
            "description": "Session not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logoutCurrentSession",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "responses": { "204": { "description": "Logged out" } }
      }
    },
    "/auth/logout-all": {
      "post": {
        "operationId": "logoutAllSessions",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "responses": { "204": { "description": "All sessions revoked" } }
      }
    },
    "/auth/phone": {
      "put": {
        "operationId": "submitPhoneCandidate",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PhoneRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated onboarding state",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSessionResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid phone",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "Recent Google re-authentication required to replace a verified phone",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "Phone version changed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/otp": {
      "post": {
        "operationId": "issuePhoneOtp",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OtpIssueRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "OTP challenge accepted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OtpChallenge" }
              }
            }
          },
          "429": {
            "description": "OTP quota or resend cooldown reached",
            "headers": {
              "Retry-After": {
                "schema": { "type": "integer", "minimum": 1 }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/otp/{challengeId}": {
      "get": {
        "operationId": "getPhoneOtpStatus",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          {
            "name": "challengeId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Current challenge state",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OtpChallenge" }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "cancelPhoneOtp",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "parameters": [
          {
            "name": "challengeId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": { "204": { "description": "Challenge cancelled" } }
      }
    },
    "/auth/otp/{challengeId}/verify": {
      "post": {
        "operationId": "verifyPhoneOtp",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "parameters": [
          {
            "name": "challengeId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OtpVerifyRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Phone verified",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSessionResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "$ref": "#/components/schemas/ErrorBody" }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": ["code", "message", "requestId", "fields"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "requestId": { "type": "string" },
          "fields": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FieldViolation" }
          }
        }
      },
      "FieldViolation": {
        "type": "object",
        "required": ["field", "code"],
        "properties": {
          "field": { "type": "string" },
          "code": { "type": "string" }
        }
      },
      "AuthSessionResponse": {
        "type": "object",
        "required": ["authenticated", "user", "session"],
        "properties": {
          "authenticated": { "type": "boolean" },
          "user": { "$ref": "#/components/schemas/AuthUser" },
          "session": { "$ref": "#/components/schemas/AuthSession" }
        }
      },
      "AuthUser": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "email",
          "onboardingStatus",
          "phoneStatus",
          "phoneVersion",
          "verificationEvidence",
          "authorities",
          "authorizationVersion",
          "nextAction"
        ],
        "properties": {
          "id": { "type": "string" },
          "displayName": { "type": "string" },
          "avatarUrl": { "type": "string" },
          "email": { "type": "string" },
          "onboardingStatus": { "type": "string" },
          "phoneStatus": { "type": "string" },
          "phoneMasked": { "type": "string" },
          "phoneVersion": { "type": "integer" },
          "verificationEvidence": { "type": "string" },
          "authorities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "authorizationVersion": { "type": "integer" },
          "nextAction": { "type": "string" }
        }
      },
      "AuthSession": {
        "type": "object",
        "required": [
          "id",
          "deviceLabel",
          "createdAt",
          "lastSeenAt",
          "idleExpiresAt",
          "absoluteExpiresAt",
          "current"
        ],
        "properties": {
          "id": { "type": "string" },
          "deviceLabel": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "lastSeenAt": { "type": "string", "format": "date-time" },
          "idleExpiresAt": { "type": "string", "format": "date-time" },
          "absoluteExpiresAt": { "type": "string", "format": "date-time" },
          "current": { "type": "boolean" }
        }
      },
      "SessionListResponse": {
        "type": "object",
        "required": ["sessions"],
        "properties": {
          "sessions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AuthSession" }
          }
        }
      },
      "PhoneRequest": {
        "type": "object",
        "required": ["phoneNumber", "expectedPhoneVersion"],
        "properties": {
          "phoneNumber": { "type": "string" },
          "expectedPhoneVersion": { "type": "integer" }
        }
      },
      "OtpIssueRequest": {
        "type": "object",
        "required": ["purpose", "phoneVersion"],
        "properties": {
          "purpose": { "type": "string" },
          "phoneVersion": { "type": "integer" }
        }
      },
      "OtpVerifyRequest": {
        "type": "object",
        "required": ["code"],
        "properties": { "code": { "type": "string" } }
      },
      "OtpChallenge": {
        "type": "object",
        "required": ["challengeId", "status", "expiresAt", "resendAfter"],
        "properties": {
          "challengeId": { "type": "string" },
          "status": { "type": "string" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "resendAfter": { "type": "string", "format": "date-time" },
          "maskedPhone": { "type": "string" }
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "DIKE_SESSION"
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-XSRF-TOKEN"
      }
    }
  }
}
