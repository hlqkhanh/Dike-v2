  "components": {
    "schemas": {
      "FieldViolation": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldViolation"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      },
      "PhoneInput": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "maxLength": 32,
            "minLength": 0
          }
        },
        "required": ["phone"]
      },
      "UserView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phoneE164": {
            "type": "string"
          },
          "phoneStatus": {
            "type": "string",
            "enum": ["NONE", "UNVERIFIED", "VERIFIED"]
          }
        },
        "required": ["displayName", "email", "id", "phoneStatus"]
      },
      "CsrfView": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": ["token"]
      },
      "DeviceView": {
        "type": "object",
        "properties": {
          "deviceSessionId": {
            "type": "string"
          },
          "issuedAt": {
            "type": "integer",
            "format": "int64"
          },
          "lastSeenAt": {
            "type": "integer",
            "format": "int64"
          },
          "expiresAt": {
            "type": "integer",
            "format": "int64"
          },
          "current": {
            "type": "boolean"
          }
        },
        "required": [
          "current",
          "deviceSessionId",
          "expiresAt",
          "issuedAt",
          "lastSeenAt"
        ]
      },
      "SessionView": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserView"
          },
          "deviceSessionId": {
            "type": "string"
          },
          "issuedAt": {
            "type": "integer",
            "format": "int64"
          },
          "expiresAt": {
            "type": "integer",
            "format": "int64"
          },
          "onboardingRequired": {
            "type": "boolean"
          }
        },
        "required": [
          "deviceSessionId",
          "expiresAt",
          "issuedAt",
          "onboardingRequired",
          "user"
        ]
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "name": "DIKE_SESSION",
        "in": "cookie"
      }
    }
  }
}
